# Copy this file to .env.local for local-only overrides.
# Never commit secrets. Environment values without NEXT_PUBLIC_ remain server-only.
APP_ENV=development

# Explicit development-only Admin bypass. Keep disabled unless intentionally testing /admin locally.
# All deployments reject ADMIN_DEV_AUTH_MODE=enabled; local requires loopback APP_ORIGIN.
ADMIN_DEV_AUTH_MODE=disabled
ADMIN_DEV_AUTH_ROLE=admin
ADMIN_DEV_AUTH_NAME=Local Admin

# Admin Auth v1. Publishable keys only; never service-role or secret keys here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Canonical trusted web origin. Vercel Preview uses an approved STAGING origin.
APP_ORIGIN=http://localhost:3000

# Private engine reads: disabled on all deployments unless STAGING gates are approved.
# Enable ONLY on the approved Vercel Custom Environment "staging":
# APP_ENV=staging, VERCEL_ENV=preview, VERCEL_TARGET_ENV=staging.
# Never set staging mode in generic preview, development or production.
DISCOVERY_READ_MODE=disabled
# Temporarily enabled ONLY for the approved Vercel STAGING read-only HTTP acceptance probe.
# Must be disabled before DISCOVERY_READ_MODE=staging; never enable in Preview/PROD.
DISCOVERY_STAGING_SMOKE_ENABLED=disabled
ENGINE_STAGING_BASE_URL=
ENGINE_STAGING_ID_TOKEN_AUDIENCE=
GCP_WORKLOAD_PROVIDER_AUDIENCE=
GCP_INVOKER_SERVICE_ACCOUNT_EMAIL=
VERCEL_EXPECTED_OIDC_ISSUER=
VERCEL_EXPECTED_OIDC_AUDIENCE=
