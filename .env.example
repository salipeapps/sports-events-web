# Copy this file to .env.local for local-only overrides.
# Never commit secrets. Environment values without NEXT_PUBLIC_ remain server-only.
APP_ENV=development

# Public catalogue H2 (#50): remote access is blocked pending Engine #122/#123.
# No demo/fixture inventory is returned by default. local-rpc is ONLY a labelled
# loopback HTTP test integration (NODE_ENV/APP_ENV=development, no Vercel).
# See docs/public-catalog.md; this is not a STAGING activation switch.
PUBLIC_CATALOG_MODE=disabled

# Explicit development-only Admin bypass. Keep disabled unless intentionally testing /admin locally.
# All deployments reject ADMIN_DEV_AUTH_MODE=enabled; local requires loopback APP_ORIGIN.
ADMIN_DEV_AUTH_MODE=disabled
ADMIN_DEV_AUTH_ROLE=admin
ADMIN_DEV_AUTH_NAME=Local Admin

# Admin Auth v1. Publishable keys only; never service-role or secret keys here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Canonical trusted web origin. Vercel Preview uses an approved STAGING origin.
APP_ORIGIN=http://localhost:3000

# Private engine reads: disabled on all deployments unless STAGING gates are approved.
# Only the DEDICATED Hobby project sports-events-web-staging may activate discovery:
# APP_ENV=staging; VERCEL_ENV=production; VERCEL_TARGET_ENV=production;
# VERCEL_PROJECT_ID must match the staging-only project and deployed branch must be develop.
# "production" above is the project-local Vercel target, NOT the real PROD web project.
# Never enable in the original sports-events-web project or generic Preview.
DISCOVERY_READ_MODE=disabled
# H1 draft (#48): future reviewed STAGING only: DISCOVERY_READ_MODE=SUPABASE_READ.
# Requires Engine #120 approval + #121 RPC contract/security tests before activation.
# Supabase mode uses only the configured publishable key and verified user session;
# keep both command flags and the legacy smoke disabled. No Google OIDC config required.
# Rollback: DISCOVERY_READ_MODE=disabled (never an automatic fallback to HTTP/demo).
# Independent server-only command gates. Activation belongs to engine #87.
DISCOVERY_REJECTION_ENABLED=disabled
# Ignored: Engine admission (#102) only covers rejection, so promotion stays closed.
DISCOVERY_PROMOTION_ENABLED=disabled
# Dedicated verified writer only; never copy reader origin/account into these.
ENGINE_COMMAND_STAGING_BASE_URL=
ENGINE_COMMAND_STAGING_VERIFIED_ORIGIN=
ENGINE_COMMAND_STAGING_ID_TOKEN_AUDIENCE=
GCP_COMMAND_INVOKER_SERVICE_ACCOUNT_EMAIL=
# Operator attestation (#41): the writer at exactly this origin enforces Engine's
# authoritative shared admission. Only engine-authoritative-rejection-v1 is accepted.
# Leave empty until #87 verifies the deployed revision; without it nothing is dispatched.
ENGINE_COMMAND_ADMISSION_CONTRACT=
ENGINE_COMMAND_ADMISSION_VERIFIED_ORIGIN=
# Temporarily enabled ONLY for the approved Vercel STAGING read-only HTTP acceptance probe.
# Must be disabled before DISCOVERY_READ_MODE=staging; never enable in any other project/Preview.
DISCOVERY_STAGING_SMOKE_ENABLED=disabled
ENGINE_STAGING_BASE_URL=
ENGINE_STAGING_ID_TOKEN_AUDIENCE=
GCP_WORKLOAD_PROVIDER_AUDIENCE=
GCP_INVOKER_SERVICE_ACCOUNT_EMAIL=
VERCEL_EXPECTED_OIDC_ISSUER=
VERCEL_EXPECTED_OIDC_AUDIENCE=
