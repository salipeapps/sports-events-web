# Copy this file to .env.local for local-only overrides.
# Never commit secrets. Environment values without NEXT_PUBLIC_ remain server-only.
APP_ENV=development

# Explicit development-only Admin bypass. Keep disabled unless intentionally testing /admin locally.
# Production rejects ADMIN_DEV_AUTH_MODE=enabled.
ADMIN_DEV_AUTH_MODE=disabled
ADMIN_DEV_AUTH_ROLE=admin
ADMIN_DEV_AUTH_NAME=Local Admin
